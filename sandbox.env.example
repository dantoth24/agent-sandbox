# Settings for agent-sandbox. A value already set in your shell wins, so
# `MODEL_PORT=9000 agent-sandbox opencode` works for a one-off.

# Port your host model server listens on. 8888 is Unsloth Studio's API.
MODEL_PORT="${MODEL_PORT:-8888}"

# Model name sent with each request. A single-model llama-server ignores it;
# it matters if you serve several models or use --alias.
MODEL_NAME="${MODEL_NAME:-unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL}"

# Context window OpenCode should assume. Match llama-server's -c.
MODEL_CONTEXT="${MODEL_CONTEXT:-131072}"

# API key for the model server (Unsloth Studio, or llama-server --api-key).
MODEL_API_KEY="${MODEL_API_KEY:-}"

# "restricted" allows only the model port and the approval proxy.
# "open" turns filtering off.
SANDBOX_NETWORK="${SANDBOX_NETWORK:-restricted}"

# Port the approval proxy listens on, on the host.
PROXY_PORT="${PROXY_PORT:-8877}"

# 1 shows a dialog for unlisted domains; 0 refuses them without asking.
PROXY_PROMPT="${PROXY_PROMPT:-1}"

# Model for `agent-sandbox hermes-claude`.
HERMES_CLAUDE_MODEL="${HERMES_CLAUDE_MODEL:-claude-opus-5-5}"

# Anthropic API key for `agent-sandbox hermes-claude`, from platform.claude.com.
# It is passed into the Hermes container only in that mode.
HERMES_ANTHROPIC_API_KEY="${HERMES_ANTHROPIC_API_KEY:-}"
